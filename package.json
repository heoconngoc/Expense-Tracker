{
  "name": "expense-tracker",
  "version": "1.0.0",
  "description": "A personal expense tracking application built to practice relational database design and SQLite.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules DB_PATH=database/test.db jest --runInBand",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules DB_PATH=database/test.db jest --runInBand --coverage"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/services/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 80,
        "branches": 70,
        "functions": 80,
        "lines": 80
      }
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "express": "^5.2.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  }
}
